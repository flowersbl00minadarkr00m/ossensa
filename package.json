    "preview": "vite preview"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ipaddr.js": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
