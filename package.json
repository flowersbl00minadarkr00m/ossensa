{
  "name": "ossensa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "dev": "npm run generate:validators && vite",
    "build": "npm run generate:validators && tsc -b && vite build",
    "check:csp-bundle": "node scripts/check-csp-bundle.mjs",
    "lint": "oxlint src",
